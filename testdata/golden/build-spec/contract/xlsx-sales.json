          "sheet": "Targets",
          "width": 14.0
        },
        "command": "xlsx colwidths set",
        "id": "sheet-2-column-3-width"
      },
      {
        "args": {
          "formatCode": "$#,##0",
          "range": "C:C",
          "sheet": "Targets"
        },
        "command": "xlsx ranges set-format",
        "id": "sheet-2-column-3-format"
      },
      {
        "args": {
          "range": "D:D",
          "sheet": "Targets",
          "width": 10.0
        },
        "command": "xlsx colwidths set",
        "id": "sheet-2-column-4-width"
      },
      {
        "args": {
          "range": "E:E",
          "sheet": "Targets",
          "width": 13.0
        },
        "command": "xlsx colwidths set",
        "id": "sheet-2-column-5-width"
      },
      {
        "args": {
          "formatCode": "yyyy-mm-dd",
          "range": "E:E",
          "sheet": "Targets"
        },
        "command": "xlsx ranges set-format",
        "id": "sheet-2-column-5-format"
      },
      {
