{
  "name": "ooxml-flue-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3583",
    "build": "vite build",
    "start": "node dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "smoke:agent": "node scripts/smoke-agent-edit.mjs",
    "smoke:auth": "node scripts/smoke-auth-isolation.mjs",
    "smoke:auth-abuse": "node scripts/smoke-auth-abuse.mjs",
    "smoke:nonpptx": "node scripts/smoke-nonpptx.mjs",
    "smoke:tools": "node scripts/smoke-flue-tools.mjs",
    "verify:stack": "node scripts/check-dependency-stack.mjs",
    "test:stream": "node --test scripts/smoke-agent-edit.test.mjs",
    "test:tools-input": "node --test scripts/ooxml-tools-input.test.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.83.0",
    "@flue/runtime": "2.0.3",
    "@flue/sdk": "2.0.3",
    "@valibot/to-json-schema": "1.7.1",
    "hono": "^4.8.3",
    "valibot": "^1.1.0"
  },
  "devDependencies": {
    "@flue/cli": "2.0.3",
    "@flue/vite": "2.0.3",
    "@types/node": "^25.9.3",
    "typescript": "^6.0.3",
    "vite": "8.2.2"
  },
  "overrides": {
    "undici": "7.29.0",
    "ws": "8.21.0"
  }
}
