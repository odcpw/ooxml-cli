    "operations": [
      {
        "args": {
          "sheet": [
            "Sales",
            "Targets"
          ],
          "themeSeed": "2563EB"
        },
        "command": "xlsx scaffold",
        "id": "document"
      },
      {
        "args": {
          "anchor": "A1",
          "dataFormat": "json",
          "sheet": "Sales",
          "values": "[[\"Region\",\"Units\",\"Unit Price\",\"Revenue\",\"Margin\"],[\"North\",12.0,125.5,{\"formula\":\"B2*C2\"},0.25],[\"Central\",9.0,140.0,{\"formula\":\"B3*C3\"},0.2],[\"South\",15.0,118.75,{\"formula\":\"B4*C4\"},0.3],[\"West\",11.0,132.0,{\"formula\":\"B5*C5\"},0.22]]"
        },
        "command": "xlsx ranges set",
        "id": "sheet-1-data"
      },
      {
        "args": {
          "color": "2563EB",
          "sheet": "Sales"
        },
        "command": "xlsx sheets set-tab-color",
        "id": "sheet-1-tab-color"
      },
      {
        "args": {
          "rows": 1,
          "sheet": "Sales"
        },
        "command": "xlsx freeze set",
        "id": "sheet-1-freeze"
      },
      {
        "args": {
          "preset": "header",
          "range": "A1:E1",
          "sheet": "Sales"
        },
        "command": "xlsx ranges set-style",
        "id": "sheet-1-header-style"
      },
      {
        "args": {
          "range": "A:A",
          "sheet": "Sales",
          "width": 18.0
        },
        "command": "xlsx colwidths set",
        "id": "sheet-1-column-1-width"
      },
      {
        "args": {
          "range": "B:B",
          "sheet": "Sales",
          "width": 10.0
        },
        "command": "xlsx colwidths set",
        "id": "sheet-1-column-2-width"
      },
      {
        "args": {
          "range": "C:C",
          "sheet": "Sales",
          "width": 14.0
        },
        "command": "xlsx colwidths set",
        "id": "sheet-1-column-3-width"
      },
      {
        "args": {
          "formatCode": "$#,##0.00",
          "range": "C1:C5",
          "sheet": "Sales"
        },
        "command": "xlsx ranges set-format",
        "id": "sheet-1-column-3-format"
      },
      {
        "args": {
          "range": "D:D",
          "sheet": "Sales",
          "width": 14.0
        },
        "command": "xlsx colwidths set",
        "id": "sheet-1-column-4-width"
      },
      {
        "args": {
          "formatCode": "$#,##0.00",
          "range": "D1:D5",
          "sheet": "Sales"
        },
        "command": "xlsx ranges set-format",
        "id": "sheet-1-column-4-format"
      },
      {
        "args": {
          "range": "E:E",
          "sheet": "Sales",
          "width": 12.0
        },
        "command": "xlsx colwidths set",
        "id": "sheet-1-column-5-width"
      },
      {
        "args": {
          "formatCode": "0.0%",
          "range": "E1:E5",
          "sheet": "Sales"
        },
        "command": "xlsx ranges set-format",
        "id": "sheet-1-column-5-format"
      },
      {
        "args": {
          "range": {
            "$ref": "sheet-1-data.destination.range"
          },
          "sheet": "Sales",
          "style": "TableStyleMedium2",
          "table": "SalesTable",
          "totalRow": true,
          "totals": "Revenue:sum"
        },
        "command": "xlsx tables create",
        "id": "sheet-1-table-1"
      },
      {
        "args": {
          "cfvo": [
            "min",
            "percentile:50",
            "max"
          ],
          "color": [
            "F8696B",
            "FFEB84",
            "63BE7B"
          ],
          "priority": 1,
          "range": "E2:E5",
          "sheet": "Sales",
          "type": "color-scale"
        },
        "command": "xlsx conditional-formats add",
        "id": "sheet-1-conditional-format-1"
      },
      {
        "args": {
          "allowBlank": false,
          "inputMessage": "Choose a sales region",
          "inputTitle": "Region",
          "listValues": "North,Central,South,West",
          "range": "A2:A5",
          "sheet": "Sales",
          "showInputMessage": true,
          "type": "list"
        },
        "command": "xlsx data-validations create",
        "id": "sheet-1-data-validation-1"
      },
      {
        "args": {
          "name": "RevenueData",
          "range": "D2:D5",
          "sheet": "Sales"
        },
        "command": "xlsx names add",
        "id": "sheet-1-name-1"
      },
      {
        "args": {
          "anchor": "G2",
          "range": "A1:B5",
          "sheet": "Sales",
          "style": "default",
          "title": "Units by Region",
          "type": "bar"
        },
        "command": "xlsx charts create",
        "id": "sheet-1-chart-1"
      },
      {
        "args": {
          "cell": "A7",
          "display": "Sales portal",
          "sheet": "Sales",
          "tooltip": "Open the sales portal",
          "url": "https://example.com/sales"
        },
        "command": "xlsx hyperlinks add",
        "id": "sheet-1-hyperlink-1"
      },
      {
        "args": {
          "author": "Finance",
          "cell": "D1",
          "sheet": "Sales",
          "text": "Calculated revenue"
        },
        "command": "xlsx comments add",
        "id": "sheet-1-comment-1"
      },
      {
        "args": {
          "fitToWidth": 1,
          "gridlines": "off",
          "landscape": true,
          "repeatHeaderRows": 1,
          "sheet": "Sales"
        },
        "command": "xlsx sheets set-print",
        "id": "sheet-1-print"
      },
      {
        "args": {
          "anchor": "A1",
          "dataFormat": "csv",
          "sheet": "Targets",
          "valuesFile": "targets.csv"
        },
        "command": "xlsx ranges set",
        "id": "sheet-2-data"
      },
      {
        "args": {
          "color": "16A34A",
          "sheet": "Targets"
        },
        "command": "xlsx sheets set-tab-color",
        "id": "sheet-2-tab-color"
      },
      {
        "args": {
